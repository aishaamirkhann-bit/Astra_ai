POSTGRES_DB=astra_db
POSTGRES_USER=astra
POSTGRES_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password
SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_COOKIE_DOMAIN=.astra.example
AUTH_COOKIE_SAMESITE=lax
TRUSTED_PROXY_IPS=*
WEB_PORT=3000
PUBLIC_API_URL=https://api.astra.example
FRONTEND_ORIGIN=https://astra.example
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
CONSENT_RATE_LIMIT=10
OTP_RATE_LIMIT=8
RATE_LIMIT_WINDOW_SECONDS=60
STT_PROVIDER=deepgram
STT_API_KEY=replace-me
SMS_PROVIDER=twilio
SMS_API_KEY=replace-me
SMS_FROM_NUMBER=replace-me
SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@astra.example
SMTP_USE_TLS=true
OTP_DEBUG_LOG=false

# --- Exposed API port (host side) ---
API_PORT=8000

# --- Card payments via Stripe (wallet-only rails when empty) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Live market-price feed (USD->PKR reference) ---
MARKET_FEED_ENABLED=true
MARKET_FEED_URL=https://open.er-api.com/v6/latest/USD
MARKET_BASELINE_USD_PKR=278.5
