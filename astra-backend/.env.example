# Copy this file to .env and fill values in

# App
APP_NAME=ASTRA AI Backend
APP_ENV=development
APP_DEBUG=true

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (SQLite for dev, swap to Postgres URL for production)
DATABASE_URL=sqlite:///./astra.db
# Example Postgres: DATABASE_URL=postgresql://user:password@localhost:5432/astra_db
# Production: add sslmode=require when required by your managed provider.
# Optional Explore catalog PostgreSQL connection. When omitted, Explore uses
# the local SQLite catalog database.
# ASTRA_DATABASE_URL=postgresql://username:password@localhost:5432/astra_ai

# Real-time Deals pipeline
REDIS_URL=redis://localhost:6379/0
# Production example: REDIS_URL=rediss://default:password@redis-host:6379/0
DEAL_EVENT_CHANNEL=astra:deals
DEAL_SCAN_INTERVAL_SECONDS=30
DEAL_RESERVATION_MINUTES=10

# CORS - Next.js dev server
FRONTEND_ORIGIN=http://localhost:3000

# Human approval reversible checkout window (seconds) - matches frontend timer
APPROVAL_WINDOW_SECONDS=30

# Email OTP delivery (choose Resend or SMTP; never commit real credentials)
# Resend is preferred when RESEND_API_KEY is set. The sandbox sender can only
# deliver to the Resend account email; use a verified domain for production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ASTRA AI <onboarding@resend.dev>
# Gmail SMTP: use a Google app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ASTRA AI
SMTP_USE_TLS=true
OTP_DEBUG_LOG=true

# Optional Groq seller agent. If blank, trust/market rules are used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=8
