# Copy to .env for local development. Never commit real credentials.

APP_NAME=ASTRA AI Backend
APP_ENV=development
ENVIRONMENT=
APP_DEBUG=true
LOG_FORMAT=

SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
AUTH_COOKIE_NAME=astra_token
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Google OAuth (optional; add real credentials to enable provider authentication).
# In APP_ENV=development/dev/demo, the backend instead opens a clearly marked
# local demo account when these values are empty. Never use fake OAuth secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SQLite is the local fallback. Use the Neon connection string in production.
DATABASE_URL=sqlite:///./astra.db
# Example only: postgresql://user:password@host/dbname?sslmode=require

REDIS_URL=
DEAL_EVENT_CHANNEL=astra:deals
DEAL_SCAN_INTERVAL_SECONDS=30
DEAL_RESERVATION_MINUTES=10

MARKET_FEED_ENABLED=true
MARKET_FEED_URL=https://open.er-api.com/v6/latest/USD
MARKET_FEED_TTL_SECONDS=3600
MARKET_OBSERVATION_INTERVAL_HOURS=6
MARKET_BASELINE_USD_PKR=278.5

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-product-search.p.rapidapi.com
PRODUCT_PROVIDER_TIMEOUT_SECONDS=5
REFRESH_PRODUCTS_ON_STARTUP=false

# Product research uses Tavily by default; Brave Search is also supported.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
RESEARCH_CACHE_TTL_HOURS=24

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
STRIPE_CONNECT_ENABLED=false
PLATFORM_FEE_PERCENT=10

FRONTEND_URL=http://localhost:3000
# Deprecated compatibility alias; FRONTEND_URL takes precedence.
# FRONTEND_ORIGIN=http://localhost:3000
APPROVAL_WINDOW_SECONDS=60
REVERSAL_MONITOR_INTERVAL_SECONDS=5
CHECKOUT_SESSION_TTL_SECONDS=600

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_TOKEN_EXPIRE_MINUTES=10
RATE_LIMIT_WINDOW_SECONDS=60
CONSENT_RATE_LIMIT=10
OTP_RATE_LIMIT=8

STT_PROVIDER=
STT_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=

TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE=
TTS_MODEL=
TTS_TIMEOUT_SECONDS=8

VISION_PROVIDER=
VISION_API_KEY=
VISION_MODEL=qwen/qwen3.8-27b
VISION_TIMEOUT_SECONDS=30
FUSION_TEXT_WEIGHT=1
FUSION_IMAGE_WEIGHT=0.7
FUSION_VOICE_WEIGHT=0.9

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=8

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@astra.ai
SMTP_FROM_NAME=ASTRA AI
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=ASTRA AI <onboarding@resend.dev>
OTP_DEBUG_LOG=true
